#!/command/with-contenv bashio
# shellcheck shell=bash
exec 2>&1

# The watcher depends on nginx and PHP-FPM, so the initial publish can use the REST API.
APP_HOST=$(bashio::info.hostname)
APP_PORT=$(bashio::app.port 8000)
export COPS_HOST="$APP_HOST"
export COPS_PORT="$APP_PORT"

# Watch /cops/library parent directory for changes to metadata.db
# Publish stats immediately when that happens, otherwise publish every 5 minutes to keep Home Assistant up to date.
while true; do
    filename=$(inotifywait -q -e close_write,moved_to -t 300 \
        --format '%f' /cops/library)
    result=$?

    if [ "$result" -eq 2 ]; then
        filename=metadata.db
    elif [ "$result" -ne 0 ]; then
        exit "$result"
    fi

    if [ "$filename" = "metadata.db" ] && [ -f /cops/library/metadata.db ]; then
        php /publish_stats.php > /dev/null
    fi
done